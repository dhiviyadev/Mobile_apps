    "@hub/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@colyseus/sdk": "0.18.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
