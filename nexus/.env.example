# NEXUS static configuration. Copy to .env or export before starting the core.
# Runtime preferences (models, voice, cloud consent…) are edited in Settings, not here.
# Secrets (cloud API keys, Hermes API key) belong in the macOS Keychain via Settings — never in this file.

# Where NEXUS stores its database, workspace, logs and backups
# NEXUS_DATA_DIR=/Users/you/nexus/data
NEXUS_PORT=8765
NEXUS_LOG_LEVEL=info
NEXUS_OLLAMA_URL=http://127.0.0.1:11434

# Hermes: auto | api | cli | off   (NEXUS never edits ~/.hermes)
NEXUS_HERMES_MODE=auto
NEXUS_HERMES_API_URL=http://127.0.0.1:8642
# NEXUS_HERMES_BIN=/Users/you/.local/bin/hermes

# Voice (optional)
# NEXUS_WHISPER_MODEL=/Users/you/models/ggml-small.en.bin
# NEXUS_PIPER_VOICE=/Users/you/models/en_GB-alan-medium.onnx
